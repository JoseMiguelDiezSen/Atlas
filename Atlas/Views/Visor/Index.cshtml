@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Título de la pestaña en el navegador -->
    <title>Atlas - Visor</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
    <link href="~/css/Radiologia.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="theme-dark visor-page">

<div class="visor-app-wrapper">

    <!-- ===================== ENCABEZADO PRINCIPAL ATLAS ===================== -->
    <header class="rad-header">
        <!-- A la izquierda: solo el logo corporativo -->
        <div class="rad-header-logo d-flex align-items-center">
            <img src="~/media/images/logoJMD.png" alt="Logo JMD" class="rad-logo-img" />
        </div>
        <!-- A la derecha: título principal de la estación PACS -->
        <div class="rad-header-title d-flex align-items-center">
            <span class="rad-brand-text">ATLAS - Visor DICOM</span>
        </div>
    </header>

    <!-- ===================== BARRA DE CONTROLES SUPERIOR ===================== -->
    <div class="row control-bar g-2">
        <div class="col-12 control-wrapper">

            <!-- GRUPO 1: ZOOM +/- Y FIT -->
            <div class="control-group">
                <button class="btn-rad-tool" id="zoomIn" title="Aumentar Zoom (+)">
                    <i class="fa fa-plus"></i>
                </button>
                <button class="btn-rad-tool" id="zoomOut" title="Disminuir Zoom (-)">
                    <i class="fa fa-minus"></i>
                </button>
                <button class="btn-rad-tool" id="zoomFit" title="Ajustar al Visor (Fit)">
                    <i class="fa-solid fa-expand"></i>
                </button>
            </div>

            <div class="control-divider"></div>

            <!-- GRUPO 2: BRILLO, CONTRASTE Y ESCALA -->
            <div class="control-group">
                <div class="slider-container" title="Ajustar Brillo (Window Center)">
                    <span class="slider-label"><i class="fa-solid fa-sun text-warning"></i> Brillo</span>
                    <input type="range" id="brightness" class="rad-range" min="-500" max="500" value="0">
                </div>

                <div class="slider-container" title="Ajustar Contraste (Window Width)">
                    <span class="slider-label"><i class="fa-solid fa-circle-half-stroke text-info"></i> Contraste</span>
                    <input type="range" id="contrast" class="rad-range" min="1" max="4000" value="4095">
                </div>

                <div class="slider-container" title="Ajustar Escala / Tamaño">
                    <span class="slider-label"><i class="fa-solid fa-magnifying-glass text-success"></i> Escala</span>
                    <input type="range" id="tamanio" class="rad-range" min="0" max="100" value="50">
                </div>
            </div>

            <div class="control-divider"></div>

            <!-- GRUPO 3: ORIENTACIÓN Y MANIPULACIÓN -->
            <div class="control-group">
                <button class="btn-rad-tool" id="btnRotateLeft" title="Rotar -90° Antihorario">
                    <i class="fa-solid fa-rotate-left"></i>
                </button>
                <button class="btn-rad-tool" id="btnRotateRight" title="Rotar +90° Horario">
                    <i class="fa-solid fa-rotate-right"></i>
                </button>
                <button class="btn-rad-tool" id="btnFlipH" title="Volteo Horizontal (Espejo)">
                    <i class="fa-solid fa-arrows-left-right"></i>
                </button>
                <button class="btn-rad-tool" id="btnFlipV" title="Volteo Vertical">
                    <i class="fa-solid fa-arrows-up-down"></i>
                </button>
                <button class="btn-rad-tool" id="btnInvert" title="Invertir Negativo / Positivo">
                    <i class="fa-solid fa-circle-half-stroke"></i>
                </button>
            </div>

            <div class="control-divider"></div>

            <!-- GRUPO 4: BLOQUEO DE CONTROLES -->
            <div class="control-group">
                <label class="switch" title="Bloquear / Desbloquear interacción del visor">
                    <input type="checkbox" id="toggleBtn">
                    <span class="slider"></span>
                </label>
                <span id="toggleState" title="Estado de bloqueo">🔓</span>
            </div>

            <div class="control-divider"></div>

            <!-- GRUPO 5: HERRAMIENTAS DE DIBUJO / MEDIDA / LUPA -->
            <div class="control-group">
                <select id="toolMode" name="toolMode" class="form-select form-select-sm rad-select" style="min-width:185px;">
                    <option value="none" selected>✋ Navegación (Pan)</option>
                    <option value="point">📍 Punto (Marcador)</option>
                    <option value="line">📏 Línea (Medición mm)</option>
                    <option value="rectangle">⬛ Rectángulo (ROI)</option>
                    <option value="angle">📐 Ángulo (3 puntos °)</option>
                    <option value="magnifier">🔍 Lupa diagnóstica</option>
                </select>

                <!-- Presets anatómicos rápidos -->
                <select id="wlPresets" class="form-select form-select-sm rad-select" style="min-width:140px;" title="Presets de ventana anatómica">
                    <option value="default" selected>Ventana: Defecto</option>
                    <option value="bone">🦴 Hueso</option>
                    <option value="softTissue">🥩 Tejido Blando</option>
                    <option value="lung">🫁 Pulmón</option>
                    <option value="brain">🧠 Cerebro</option>
                </select>
            </div>

            <div class="control-divider"></div>

            <!-- GRUPO 6: ACCIONES (LIMPIAR, RESET, EXPORTAR, FULLSCREEN) -->
            <div class="control-group">
                <button class="btn-rad-action btn-clear" id="limpiarDibujos" title="Borrar todas las anotaciones y dibujos">
                    <i class="fa-solid fa-eraser"></i> <span>Limpiar</span>
                </button>
                <button class="btn-rad-action btn-reset" id="reset" title="Restablecer valores originales">
                    <i class="fa fa-rotate-left"></i> <span>Reset</span>
                </button>
                <button class="btn-rad-action btn-export" id="btnExportCapture" title="Descargar captura PNG médica en alta resolución">
                    <i class="fa-solid fa-camera"></i> <span>Captura</span>
                </button>
                <button class="btn-rad-action btn-fullscreen" id="abrirVisor" onclick="abrirVisorFullScreen()" title="Pantalla completa">
                    <i class="fa fa-maximize"></i> <span>Pantalla Completa</span>
                </button>
            </div>

        </div>
    </div>

    <!-- ===================== CONTENEDOR PRINCIPAL FLEXIBLE PACS ===================== -->
    <div class="pacs-workspace-container">

        <!-- COLUMNA 1: PANEL IZQUIERDO (ESTUDIOS, MINIATURAS, CARGA LOCAL) -->
        <aside class="pacs-panel pacs-panel-left" id="panelIzquierdo">
            <div class="pacs-panel-header">
                <button class="pacs-panel-close-btn" id="btnCloseLeftPanel" title="Ocultar panel">
                    <i class="fa-solid fa-angles-left"></i>
                </button>
                <span class="flex-grow-1 text-center">Explorador PACS</span>
                <div style="width:28px;" aria-hidden="true"></div>
            </div>

            <!-- LISTA DE ESTUDIOS -->
            <div class="rad-card mb-2">
                <div class="rad-card-title justify-content-center text-center">
                    Estudios DCM
                </div>

                <div class="thumbnails-container" id="thumbnailsList">
                    <!-- 5.dcm es el estudio principal verificado y funcional -->
                    <div class="thumbnail-item active" data-dcm="/media/images/Radiografias/5.dcm" data-code="R-00" data-date="05-09-2026">
                        <div class="thumbnail-icon-box">
                            <i class="fa-solid fa-x-ray"></i>
                        </div>
                        <div class="thumbnail-meta">
                            <div class="thumbnail-code">R-00 (Principal)</div>
                            <div class="thumbnail-date">05/09/2026 • 2048x2048</div>
                        </div>
                    </div>

                    <div class="thumbnail-item" data-dcm="/media/images/Radiografias/6.dcm" data-code="R-00 Alt" data-date="05-09-2026">
                        <div class="thumbnail-icon-box">
                            <i class="fa-solid fa-x-ray"></i>
                        </div>
                        <div class="thumbnail-meta">
                            <div class="thumbnail-code">R-00 (Alt)</div>
                            <div class="thumbnail-date">05/09/2026</div>
                        </div>
                    </div>

                    <div class="thumbnail-item" data-dcm="/media/images/Radiografias/7.dcm" data-code="R-01" data-date="17-03-2026">
                        <div class="thumbnail-icon-box">
                            <i class="fa-solid fa-x-ray"></i>
                        </div>
                        <div class="thumbnail-meta">
                            <div class="thumbnail-code">R-01</div>
                            <div class="thumbnail-date">17/03/2026</div>
                        </div>
                    </div>

                    <div class="thumbnail-item" data-dcm="/media/images/Radiografias/2.dcm" data-code="R-02" data-date="21-03-2026">
                        <div class="thumbnail-icon-box">
                            <i class="fa-solid fa-x-ray"></i>
                        </div>
                        <div class="thumbnail-meta">
                            <div class="thumbnail-code">R-02</div>
                            <div class="thumbnail-date">21/03/2026</div>
                        </div>
                    </div>

                    <div class="thumbnail-item" data-dcm="/media/images/Radiografias/3.dcm" data-code="R-03" data-date="27-05-2026">
                        <div class="thumbnail-icon-box">
                            <i class="fa-solid fa-x-ray"></i>
                        </div>
                        <div class="thumbnail-meta">
                            <div class="thumbnail-code">R-03</div>
                            <div class="thumbnail-date">27/05/2026</div>
                        </div>
                    </div>

                    <div class="thumbnail-item" data-dcm="/media/images/Radiografias/4.dcm" data-code="R-04" data-date="05-09-2026">
                        <div class="thumbnail-icon-box">
                            <i class="fa-solid fa-x-ray"></i>
                        </div>
                        <div class="thumbnail-meta">
                            <div class="thumbnail-code">R-04</div>
                            <div class="thumbnail-date">05/09/2026</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SELECTOR CLÁSICO COMPATIBLE -->
            <div class="rad-card">
                <div class="rad-card-title justify-content-center text-center">
                    Selector Rápido
                </div>
                <select name="ListadoRadiografias" class="form-select form-select-sm rad-select w-100 mb-2" id="listadoRadiografias">
                    <option value="/media/images/Radiografias/5.dcm" selected>R-00 Principal (Verificado)</option>
                    <option value="/media/images/Radiografias/6.dcm">R-00 Alt (05-09-2026)</option>
                    <option value="/media/images/Radiografias/7.dcm">R-01 (17-03-2026)</option>
                    <option value="/media/images/Radiografias/2.dcm">R-02 (21-03-2026)</option>
                    <option value="/media/images/Radiografias/3.dcm">R-03 (27-05-2026)</option>
                    <option value="/media/images/Radiografias/4.dcm">R-04 (05-09-2026)</option>
                </select>

                <label class="rad-info-label mb-1" for="Posicion">
                    <i class="fa-solid fa-arrows-up-down-left-right"></i> Proyección
                </label>
                <select name="posicionRadiografias" class="form-select form-select-sm rad-select w-100" id="Posicion">
                    <option value="" selected disabled>(Seleccione posición)</option>
                    <option value="2">Frontal (PA / AP)</option>
                    <option value="3">Lateral Izquierda</option>
                    <option value="4">Lateral Derecha</option>
                    <option value="5">Axial / Oblicua</option>
                </select>
            </div>
        </aside>

        <!-- COLUMNA 2: LIENZO CENTRAL (VIEWPORT DICOM & TELEMETRÍA) -->
        <main class="pacs-viewport-main" id="centerViewport">

            <!-- BOTÓN REAPERTURA PANEL IZQ (si está cerrado) -->
            <button class="pacs-floating-toggle-btn pacs-toggle-left" id="btnOpenLeftPanel" title="Mostrar Explorador de Estudios">
                <i class="fa-solid fa-angles-right"></i>
            </button>

            <!-- BOTÓN REAPERTURA PANEL DER (si está cerrado) -->
            <button class="pacs-floating-toggle-btn pacs-toggle-right" id="btnOpenRightPanel" title="Mostrar Herramientas e Inspector">
                <i class="fa-solid fa-angles-left"></i>
            </button>

            <!-- CONTENEDOR DEL VISOR -->
            <div class="viewer-wrapper">

                <!-- BARRA DE CONTROLES FLOTANTE EN PANTALLA COMPLETA -->
                <div class="fullscreen-floating-bar" id="fsFloatingBar">
                    <div class="control-group">
                        <div class="slider-container" title="Ajustar Brillo">
                            <span class="slider-label"><i class="fa-solid fa-sun text-warning"></i> Brillo</span>
                            <input type="range" id="fs_brightness" class="rad-range" min="-500" max="500" value="0">
                        </div>

                        <div class="slider-container" title="Ajustar Contraste">
                            <span class="slider-label"><i class="fa-solid fa-circle-half-stroke text-info"></i> Contraste</span>
                            <input type="range" id="fs_contrast" class="rad-range" min="1" max="4000" value="2000">
                        </div>

                        <div class="slider-container" title="Ajustar Escala / Zoom">
                            <span class="slider-label"><i class="fa-solid fa-magnifying-glass text-success"></i> Escala</span>
                            <input type="range" id="fs_tamanio" class="rad-range" min="0" max="100" value="50">
                        </div>
                    </div>

                    <div class="control-divider"></div>

                    <div class="control-group">
                        <select id="fs_toolMode" class="form-select form-select-sm rad-select" style="width:175px;" title="Herramientas de dibujo">
                            <option value="none" selected>✋ Navegación (Pan)</option>
                            <option value="point">📍 Punto</option>
                            <option value="line">📏 Línea (Medición)</option>
                            <option value="rectangle">⬛ Rectángulo</option>
                            <option value="angle">📐 Ángulo</option>
                            <option value="magnifier">🔍 Lupa</option>
                        </select>
                    </div>

                    <div class="control-divider"></div>

                    <div class="control-group">
                        <button class="btn-rad-tool" id="fs_limpiarDibujos" title="Limpiar dibujos y anotaciones">
                            <i class="fa-solid fa-eraser"></i>
                        </button>
                        <button class="btn-rad-tool" id="fs_reset" title="Restablecer vista original (Reset)">
                            <i class="fa fa-rotate-left"></i>
                        </button>
                        <button class="btn-rad-tool" id="fs_exitBtn" title="Salir de Pantalla Completa" onclick="salirVisorFullScreen()">
                            <i class="fa-solid fa-compress"></i>
                        </button>
                    </div>
                </div>

                <!-- HUD CLÍNICO DE 4 CUADRANTES -->
                <div class="hud-tag hud-top-left" id="hudPatient">
                    <i class="fa-solid fa-hospital-user text-info me-1"></i> PACIENTE: DEMO
                </div>
                <div class="hud-tag hud-top-right" id="hudStudy">
                    <i class="fa-solid fa-file-medical text-primary me-1"></i> ESTUDIO: CARGANDO...
                </div>
                <div class="hud-tag hud-bottom-left" id="hudZoom">
                    <i class="fa-solid fa-crosshairs text-success me-1"></i> MODO: PAN
                </div>
                <div class="hud-tag hud-bottom-right" id="hudVOI">
                    <i class="fa-solid fa-circle-half-stroke text-warning me-1"></i> WC: -- | WW: --
                </div>

                <!-- NOTIFICACIÓN / ALERTA DE FORMATO O COMPRESIÓN -->
                <div id="dicomAlertBanner" class="pacs-alert-banner" style="display:none;">
                    <i class="fa-solid fa-triangle-exclamation text-warning me-2"></i>
                    <span id="dicomAlertText">Aviso sobre el archivo DICOM</span>
                    <button type="button" class="btn-close btn-close-white ms-3" id="btnCloseAlert" aria-label="Close"></button>
                </div>

                <!-- SPINNER DE CARGA -->
                <div id="textoVisor">
                    <i class="fa-solid fa-circle-notch fa-spin text-info"></i>
                    <span id="textoVisorMsg">Cargando estudio DICOM...</span>
                </div>

                <!-- CANVAS DE CORNERSTONE -->
                <div id="dicomViewer"></div>

                <!-- LUPA FLOTANTE VIRTUAL (MAGNIFIER) -->
                <div id="magnifierCanvas" class="pacs-magnifier-lens" style="display:none;">
                    <canvas id="magnifierInnerCanvas"></canvas>
                </div>
            </div>

            <!-- ===================== BARRA DE TELEMETRÍA INFERIOR ===================== -->
            <div class="pacs-telemetry-bar">
                <div class="telemetry-item">
                    <span class="telemetry-label"><i class="fa-solid fa-magnifying-glass text-success"></i> Zoom:</span>
                    <span class="telemetry-value" id="telZoom">100%</span>
                </div>
                <div class="telemetry-divider"></div>
                <div class="telemetry-item">
                    <span class="telemetry-label"><i class="fa-solid fa-location-crosshairs text-info"></i> Posición:</span>
                    <span class="telemetry-value" id="telCoord">X: -- | Y: --</span>
                </div>
                <div class="telemetry-divider"></div>
                <div class="telemetry-item">
                    <span class="telemetry-label"><i class="fa-solid fa-droplet text-warning"></i> Intensidad:</span>
                    <span class="telemetry-value" id="telPixelValue">-- HU</span>
                </div>
                <div class="telemetry-divider"></div>
                <div class="telemetry-item">
                    <span class="telemetry-label"><i class="fa-solid fa-chart-area text-success"></i> Matriz:</span>
                    <span class="telemetry-value" id="telMatrix">-- x -- px</span>
                </div>
                <div class="telemetry-divider"></div>
                <div class="telemetry-item">
                    <span class="telemetry-label"><i class="fa-solid fa-ruler-combined text-primary"></i> Espaciado:</span>
                    <span class="telemetry-value" id="telSpacing">-- mm/px</span>
                </div>
                <div class="telemetry-divider"></div>
                <div class="telemetry-item">
                    <span class="telemetry-label"><i class="fa-solid fa-arrows-rotate text-info"></i> Orientación:</span>
                    <span class="telemetry-value" id="telOrientation">Rot: 0° | Normal</span>
                </div>
            </div>

        </main>

        <!-- COLUMNA 3: PANEL DERECHO (INSPECTOR DICOM, MEDICIONES Y AJUSTES) -->
        <aside class="pacs-panel pacs-panel-right" id="panelDerecho">
            <div class="pacs-panel-header">
                <div style="width:28px;" aria-hidden="true"></div>
                <span class="flex-grow-1 text-center">Datos del Paciente</span>
                <button class="pacs-panel-close-btn" id="btnCloseRightPanel" title="Ocultar panel">
                    <i class="fa-solid fa-angles-right"></i>
                </button>
            </div>

            <!-- SELECTOR DE PACIENTES (DESPLEGABLE) -->
            <div class="rad-card mb-2">
                <div class="rad-card-title justify-content-center text-center">
                    Seleccionar Paciente
                </div>
                <select id="selectorPaciente" class="form-select form-select-sm rad-select w-100">
                    <option value="">-- Seleccionar Paciente --</option>
                    @if (ViewBag.Pacientes != null)
                    {
                        foreach (var pac in (List<Negocio.Persistencia.Modelos.Paciente>)ViewBag.Pacientes)
                        {
                            <option value="@pac.IdPaciente">@pac.Apellidos, @pac.Nombre (@pac.DNI)</option>
                        }
                    }
                </select>
            </div>

            <!-- FICHA DE PACIENTE -->
            <div class="rad-card mb-2">
                <div class="rad-card-title justify-content-center text-center">
                    Datos del Paciente
                </div>
                <div class="rad-info-row">
                    <span class="rad-info-label">Nombre</span>
                    <span class="rad-info-value" id="cardPatientName">N/D</span>
                </div>
                <div class="rad-info-row mt-2">
                    <span class="rad-info-label">N° Hª Clínica</span>
                    <span class="rad-info-value" id="cardPatientHist">N/D</span>
                </div>
                <div class="rad-info-row mt-2">
                    <span class="rad-info-label">F. Nacimiento</span>
                    <span class="rad-badge" id="cardPatientBirth">N/D</span>
                </div>
                <div class="rad-info-row mt-2">
                    <span class="rad-info-label">Sexo</span>
                    <span class="rad-info-value" id="cardPatientSex">N/D</span>
                </div>
                <div class="rad-info-row mt-2">
                    <span class="rad-info-label">Teléfono</span>
                    <span class="rad-info-value" id="cardPatientPhone">N/D</span>
                </div>
                <div class="rad-info-row mt-2">
                    <span class="rad-info-label">Email</span>
                    <span class="rad-info-value text-truncate" id="cardPatientEmail" style="max-width: 170px;" title="">N/D</span>
                </div>
                <div class="rad-info-row mt-2">
                    <span class="rad-info-label">Ciudad</span>
                    <span class="rad-info-value" id="cardPatientCity">N/D</span>
                </div>
                <div class="rad-info-row mt-2">
                    <span class="rad-info-label">Fecha</span>
                    <span class="rad-info-value" id="cardPatientDate">N/D</span>
                </div>
            </div>

            <!-- CARGA DE ARCHIVO DICOM LOCAL (ESQUINA INFERIOR DERECHA) -->
            <div class="rad-card mt-auto mb-2">
                <div class="rad-card-title justify-content-center text-center">
                    Cargar DICOM
                </div>
                <label for="localDicomInput" class="btn-rad-action w-100 justify-content-center text-center py-2" style="cursor:pointer;">
                    <i class="fa-solid fa-file-medical text-info"></i> Seleccionar .dcm
                </label>
                <input type="file" id="localDicomInput" accept=".dcm,application/dicom" style="display:none;" />
            </div>

        </aside>

    </div>

</div>

<!-- MODAL COMPATIBILIDAD -->
<div class="modal fade" tabindex="-1" role="dialog" data-bs-backdrop="static" data-keyboard="false" id="modalRadiografia">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content bg-dark text-light border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-center text-info">
                    <i class="fa fa-notes-medical" aria-hidden="true"></i> Radiografía Clínica
                </h5>
                <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Contenido dinámico si se requiere -->
            </div>
        </div>
    </div>
</div>

<!-- MENÚ CONTEXTUAL CLÍNICO PACS -->
<div id="pacsContextMenu" class="pacs-context-menu" style="display:none;">
    <div class="pacs-ctx-header">Herramientas PACS</div>
    
    <div class="pacs-ctx-item" data-action="tool" data-val="none">
        <i class="fa-solid fa-hand"></i> <span>Navegación (Pan)</span>
    </div>
    <div class="pacs-ctx-item" data-action="tool" data-val="line">
        <i class="fa-solid fa-ruler"></i> <span>Medir Distancia</span>
    </div>
    <div class="pacs-ctx-item" data-action="tool" data-val="rectangle">
        <i class="fa-regular fa-square"></i> <span>Área / ROI</span>
    </div>
    <div class="pacs-ctx-item" data-action="tool" data-val="angle">
        <i class="fa-solid fa-draw-polygon"></i> <span>Medir Ángulo</span>
    </div>
    <div class="pacs-ctx-item" data-action="tool" data-val="magnifier">
        <i class="fa-solid fa-magnifying-glass-plus"></i> <span>Lupa Diagnóstica</span>
    </div>

    <div class="pacs-ctx-divider"></div>

    <div class="pacs-ctx-item" data-action="clear">
        <i class="fa-solid fa-eraser"></i> <span>Limpiar Mediciones</span>
    </div>
    <div class="pacs-ctx-item" data-action="reset">
        <i class="fa-solid fa-rotate-left"></i> <span>Restablecer (Reset)</span>
    </div>
</div>

