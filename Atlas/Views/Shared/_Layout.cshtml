<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Atlas</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />


    <!-- Referencia a FontAwesome -->
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>
@{
    bool isVisor = (ViewBag.Theme as string) == "theme-dark" || (ViewData["Title"] as string) == "Visor Dicom";
}
<body class="@ViewBag.Theme @(isVisor ? "visor-page" : "")">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm @(isVisor ? "navbar-dark bg-dark border-bottom border-secondary mb-2" : "navbar-light bg-white border-bottom box-shadow mb-3")">
            <div class="@(isVisor ? "container-fluid px-3" : "container-fluid")">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-circle-radiation text-info me-1"></i> Atlas PACS
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link @(isVisor ? "text-light" : "text-dark")" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isVisor ? "text-light" : "text-dark")" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(isVisor ? "text-info fw-bold" : "text-dark")" asp-area="" asp-controller="Visor" asp-action="Index">
                                <i class="fa-solid fa-laptop-medical me-1"></i> Estación Visor
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="@(isVisor ? "container-fluid px-3 py-0" : "container")">
        <main role="main" class="@(isVisor ? "p-0" : "pb-3")">
            @RenderBody()
        </main>
    </div>

    @if (!isVisor)
    {
        <footer class="border-top footer text-muted">
            <div class="container">
                &copy; 2026 - Atlas - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </footer>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>




    @await RenderSectionAsync("Scripts", required: false)

   @await RenderSectionAsync("Modals", required: false)
</body>
</html>
